{
  "info": {
    "name": "Online Shop API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "stockExportPath",
      "value": "/api/stocks/export/e0000000-0000-0000-0000-000000000001"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "reportDate",
      "value": ""
    },
    {
      "key": "todayDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Authenticate as Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin authenticated successfully', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"changeme\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "1. Setup - Populate Database",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Database populated successfully', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/test/populate"
      }
    },
    {
      "name": "2. Create Order Successfully",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Order response contains ID and userId', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a('string');",
              "    pm.expect(jsonData.userId).to.eql('a0000000-0000-0000-0000-000000000001');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"a0000000-0000-0000-0000-000000000001\",\n  \"deliveryAddress\": {\n    \"country\": \"România\",\n    \"city\": \"București\",\n    \"county\": \"București\",\n    \"streetAddress\": \"Strada Lipscani 25\"\n  },\n  \"products\": [\n    {\n      \"productId\": \"d0000000-0000-0000-0000-000000000001\",\n      \"quantity\": 5\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "3. Export Stocks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response body is not empty', function () {",
              "    pm.expect(pm.response.text().length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/csv"
          }
        ],
        "url": "{{baseUrl}}{{stockExportPath}}"
      }
    },
    {
      "name": "4. Fail to Create Order - Missing Stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Error message is present', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"a0000000-0000-0000-0000-000000000001\",\n  \"deliveryAddress\": {\n    \"country\": \"România\",\n    \"city\": \"București\",\n    \"county\": \"București\",\n    \"streetAddress\": \"Strada Lipscani 25\"\n  },\n  \"products\": [\n    {\n      \"productId\": \"d0000000-0000-0000-0000-000000000001\",\n      \"quantity\": 5000\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "5. Fail to Create Order - Unknown Product ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Error message mentions missing product', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.include('Products not found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"a0000000-0000-0000-0000-000000000001\",\n  \"deliveryAddress\": {\n    \"country\": \"România\",\n    \"city\": \"București\",\n    \"county\": \"București\",\n    \"streetAddress\": \"Strada Lipscani 25\"\n  },\n  \"products\": [\n    {\n      \"productId\": \"ffffffff-ffff-ffff-ffff-ffffffffffff\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "6. Run Revenue Report For Yesterday",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const yesterday = new Date();",
              "yesterday.setDate(yesterday.getDate() - 1);",
              "const reportDate = [",
              "    yesterday.getFullYear(),",
              "    String(yesterday.getMonth() + 1).padStart(2, '0'),",
              "    String(yesterday.getDate()).padStart(2, '0')",
              "].join('-');",
              "pm.collectionVariables.set('reportDate', reportDate);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Every location is reported', function () {",
              "    pm.expect(pm.response.json().length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/revenues/run?date={{reportDate}}"
      }
    },
    {
      "name": "7. Get Revenues For Date",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response exposes location, date and sum', function () {",
              "    const revenues = pm.response.json();",
              "    pm.expect(revenues.length).to.be.above(0);",
              "    pm.expect(revenues[0]).to.have.property('locationName');",
              "    pm.expect(revenues[0]).to.have.property('sum');",
              "    pm.expect(revenues[0].date).to.eql(pm.collectionVariables.get('reportDate'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/revenues?date={{reportDate}}"
      }
    },
    {
      "name": "8. Export Revenues As CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is a revenue CSV', function () {",
              "    pm.expect(pm.response.text()).to.include('locationId,locationName,date,sum');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/csv"
          }
        ],
        "url": "{{baseUrl}}/api/revenues/export?date={{reportDate}}"
      }
    },
    {
      "name": "9. Fail to Run Revenue Report - Day Not Complete",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const today = new Date();",
              "const todayDate = [",
              "    today.getFullYear(),",
              "    String(today.getMonth() + 1).padStart(2, '0'),",
              "    String(today.getDate()).padStart(2, '0')",
              "].join('-');",
              "pm.collectionVariables.set('todayDate', todayDate);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error explains that the day is not complete', function () {",
              "    pm.expect(pm.response.json().error).to.include('completed day');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/revenues/run?date={{todayDate}}"
      }
    },
    {
      "name": "10. Teardown - Clear Database",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Database cleared successfully', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/test/clear"
      }
    }
  ]
}